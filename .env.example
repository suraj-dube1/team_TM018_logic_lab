# Copy to .env  (cp .env.example .env)

# LLM: ollama | openrouter | anthropic | none
#  none = no LLM, extractive answers only (fastest, works fully offline)
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=VaultRAG

# Demo switches
DEMO_MODE=1            # enables the 3-user "Compare" view (shows other users' answers)
SHOW_BLOCKED_COUNT=1   # live blocked-chunk counter (diagnostic, count only)
AUTO_SEED=1            # seed synthetic company data on first start
SECRET_KEY=change-me-before-demo
VERIFY_LEX_MIN=0.5     # claim-grounding strictness (0-1)
MAX_UPLOAD_MB=25
