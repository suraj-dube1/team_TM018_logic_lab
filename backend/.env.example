# Copy to .env for local development. Never commit populated .env files.
APP_NAME=Secure Multi-Modal RAG
ENVIRONMENT=development
# Defaults to backend/data/secure_rag.db when omitted.
# DATABASE_URL=sqlite:///./data/secure_rag.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a unique local value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=30
# Optional upload settings (defaults: backend/uploads, 10 MiB).
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_SIZE_BYTES=10485760
# Optional extraction settings (defaults: English OCR, 30 text characters before PDF OCR fallback).
# OCR_LANGUAGES=eng
# MIN_EXTRACTED_TEXT_CHARS=30
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# Optional LLM configuration (defaults to auto/local fallback if unset)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=auto
# LLM_MODEL_NAME=gemini-2.5-flash
