# No-Docker setup. Copy to .env inside the backend folder:  copy ..\.env.local.example .env
ADMIN_DB_URL=paste-your-neon-connection-string-here
# APP_DB_URL is added automatically by setup_db.py

LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=VaultRAG
DEMO_MODE=1
SHOW_BLOCKED_COUNT=1
AUTO_SEED=1
SECRET_KEY=change-me-before-demo
VERIFY_LEX_MIN=0.5
# If you install Tesseract on Windows (optional, for OCR of images):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MAX_UPLOAD_MB=25
